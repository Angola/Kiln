{
  "name": "kiln",
  "version": "0.1.0",
  "private": true,
  "description": "Kiln — receive AI-collected structured data, auto-generate admin UIs.",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm run build && pnpm -r test",
    "test:unit": "pnpm -r test",
    "dev:mcp": "pnpm --filter @kiln/mcp dev",
    "dev:web": "pnpm --filter @kiln/web dev",
    "db:generate": "pnpm --filter @kiln/db generate",
    "db:migrate": "pnpm --filter @kiln/db migrate",
    "storybook": "pnpm --filter @kiln/renderer-react storybook"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "sharp"],
    "overrides": {
      "react": "18.3.1",
      "react-dom": "18.3.1",
      "@types/react": "18.3.12",
      "@types/react-dom": "18.3.1"
    }
  }
}
